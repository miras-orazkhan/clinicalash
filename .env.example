# PostgreSQL-контейнер проекта (docker run --name clinicalash … -p 127.0.0.1:5434:5432 postgres:16-alpine)
# На другой машине: docker compose up -d / docker run той же командой, затем npx prisma db push && npx prisma db seed
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5434/clinicalash

# Payload CMS (свой секрет на машину)
PAYLOAD_SECRET=change-me-random-hex
PAYLOAD_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5434/clinicalash_cms
